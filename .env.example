# Exemple uniquement : Node ne charge pas ce fichier automatiquement.
# Local : npm start fonctionne sans configuration supplémentaire.
NODE_ENV=development
HOST=127.0.0.1
PORT=8000
TRUST_PROXY=false
RATE_LIMIT_MAX=180

# Production derrière un proxy HTTPS sur la même machine :
# NODE_ENV=production
# TRUST_PROXY=loopback
# PUBLIC_ORIGIN=https://votre-domaine.example
